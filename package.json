{
  "name": "api-menu",
  "version": "1.0.0",
  "description": "API para gestão de menus com aninhamento infinito",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPatterns=usecases",
    "test:e2e": "jest --testPathPatterns=e2e --runInBand"
  },
  "dependencies": {
    "express": "4.18.2",
    "mongoose": "7.6.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "20.9.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "2.0.0",
    "typescript": "5.2.2"
  }
}
